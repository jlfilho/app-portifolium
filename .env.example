FRONTEND_PORT=4200
APP_PORT=8080

POSTGRES_DB=portifolium
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_SQL_INIT_MODE=always

# Chave em Base64 com pelo menos 32 bytes. Gere outra para producao.
JWT_SECRET_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
JWT_EXPIRATION_TIME=3600000

APP_SEED_ADMIN_ENABLED=true
APP_SEED_ADMIN_EMAIL=admin@uea.edu.br
APP_SEED_ADMIN_PASSWORD=admin123
APP_SEED_ADMIN_RESET_PASSWORD=true

# Usado pelo docker-compose.yml de producao.
APP_CORS_ALLOWED_ORIGINS=https://seudominio.com.br
FRONTEND_URL=https://seudominio.com.br

# Usado pelo docker-compose.dev.yml local.
DEV_APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DEV_FRONTEND_URL=http://localhost:4200

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
